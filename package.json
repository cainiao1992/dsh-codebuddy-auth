{
  "name": "dsh-codebuddy-auth",
  "version": "0.5.1",
  "description": "CodeBuddy (Tencent IOA) provider lifecycle plugin for DeepSeek Harness: browser OAuth login, token refresh, credential storage, and /v3/config model sync for the llm-pi-ai codebuddy route.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "codebuddy-login": "./bin/login-flow.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "login": "node bin/login-flow.mjs"
  },
  "engines": {
    "node": ">=18.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "codebuddy",
    "tencent",
    "oauth"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cainiao1992/dsh-codebuddy-auth.git"
  }
}
